<section class="view-panel" data-view="profile" aria-label="Profile view">
  <article class="panel profile-card">
    <header class="section-header">
      <h2>Perfil</h2>
      <span class="muted-pill">Personal</span>
    </header>

    <div class="profile-main">
      <div class="avatar-wrap">
        <img id="profile-avatar" alt="Profile avatar" hidden />
        <div id="profile-avatar-fallback" class="avatar-fallback">?</div>
      </div>

      <div class="profile-info">
        <h3 id="profile-display-name" class="profile-display-name">Sin nombre</h3>
        <p id="profile-username-text" class="profile-meta">@usuario</p>
        <p id="profile-email-text" class="profile-meta">correo@ejemplo.com</p>
        <p id="profile-mote-text" class="profile-mote">Sin mote</p>

        <div class="profile-actions">
          <input id="profile-photo-input" type="file" accept="image/*" hidden />
          <button class="btn" id="choose-photo-btn" type="button">Elegir foto</button>
          <button class="btn" id="open-avatar-modal-btn" type="button">Elegir marco</button>
          <button class="btn btn-primary" id="open-name-modal-btn" type="button">Cambiar nombre</button>
          <button class="btn btn-primary settings-launch-btn" id="open-settings-modal-btn" type="button">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6 1.7 1.7 0 0 0-.33 1.05V21a2 2 0 1 1-4 0v-.01a1.7 1.7 0 0 0-.33-1.05 1.7 1.7 0 0 0-1-.6 1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-.6-1 1.7 1.7 0 0 0-1.05-.33H3a2 2 0 1 1 0-4h.01a1.7 1.7 0 0 0 1.05-.33 1.7 1.7 0 0 0 .6-1 1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-.6A1.7 1.7 0 0 0 10.33 3V3a2 2 0 1 1 4 0v.01a1.7 1.7 0 0 0 .33 1.05 1.7 1.7 0 0 0 1 .6 1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.7 1.7 0 0 0 19.4 9c.28.31.49.67.6 1 .12.33.16.7.16 1.05V12c0 .35-.04.72-.16 1.05-.11.33-.32.69-.6 1Z"></path>
            </svg>
            <span>Cambiar ajustes</span>
          </button>
          <button class="btn btn-danger" id="logout-btn" type="button">Cerrar sesion</button>
        </div>
      </div>
    </div>

    <div class="profile-summary">
      <article class="summary-item">
        <p class="stat-label">Tareas totales</p>
        <p id="profile-total-tasks" class="stat-value">0</p>
      </article>
      <article class="summary-item">
        <p class="stat-label">Horas completadas</p>
        <p id="profile-total-completed" class="stat-value">0h</p>
      </article>
    </div>

    <section id="profile-rank-card" class="profile-rank-card" aria-label="Rango y progreso">
      <div class="profile-rank-head">
        <span id="profile-rank-badge" class="rank-badge">NOVATO</span>
        <div>
          <p id="profile-rank-name" class="rank-name">Novato</p>

          <p id="profile-rank-xp" class="rank-xp">0 XP</p>
        </div>
      </div>

      <div class="progress-track" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
        <div id="profile-rank-progress" class="progress-fill profile-rank-progress" style="width:0%"></div>
      </div>
      <p id="profile-next-rank" class="rank-next">0 XP para el siguiente rango</p>

      <div class="profile-kpis">
        <article class="summary-item">
          <p class="stat-label">Racha actual</p>
          <p id="profile-current-streak" class="stat-value">0</p>
        </article>
        <article class="summary-item">
          <p class="stat-label">Mejor racha</p>
          <p id="profile-best-streak" class="stat-value">0</p>
        </article>
        <article class="summary-item">
          <p class="stat-label">Cumplimiento semanal</p>
          <p id="profile-weekly-rate" class="stat-value">0%</p>
        </article>
        <article class="summary-item">
          <p class="stat-label">Tareas vencidas</p>
          <p id="profile-overdue-count" class="stat-value">0</p>
        </article>
      </div>
    </section>

    <section class="profile-battle-pass" aria-label="Pase de batalla">
      <header class="section-header">
        <h3>Pase de batalla</h3>
        <span id="profile-battle-pass-count" class="muted-pill">0 reclamadas</span>
      </header>

      <div class="battle-pass-summary">
        <article class="summary-item">
          <p class="stat-label">XP total</p>
          <p id="profile-battle-pass-xp" class="stat-value">0 XP</p>
        </article>
        <article class="summary-item">
          <p class="stat-label">Rango activo</p>
          <p id="profile-battle-pass-next" class="stat-value">0 XP para la siguiente recompensa</p>
        </article>
      </div>

      <div class="progress-track battle-pass-track" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
        <div id="profile-battle-pass-progress" class="progress-fill battle-pass-progress" style="width:0%"></div>
      </div>

      <div class="battle-pass-compact-actions">
        <p class="battle-pass-compact-copy">Abre el modal para ver cada recompensa en su punto de XP y reclamarla sin la lista larga en pantalla.</p>
        <button class="btn btn-primary" type="button" data-action="open-battle-pass-modal">Ver recompensas</button>
      </div>
    </section>

    <section class="profile-cosmetics" aria-label="Cosméticos equipados">
      <header class="section-header">
        <h3>Cosméticos equipados</h3>
        <span id="profile-motes-count" class="muted-pill">0 desbloqueados</span>
      </header>

      <div class="profile-cosmetics-grid">
        <article class="equipment-card">
          <p class="equipment-label">Mote equipado</p>
          <h4 id="profile-equipped-mote-name" class="equipment-name">Sin mote</h4>
          <p id="profile-equipped-mote-detail" class="equipment-detail">Todavía no tienes motes desbloqueados.</p>
        </article>

        <article class="equipment-card">
          <p class="equipment-label">Tema equipado</p>
          <h4 id="profile-equipped-theme-name" class="equipment-name">Ocean</h4>
          <p id="profile-equipped-theme-detail" class="equipment-detail">Tema base siempre disponible.</p>
        </article>
      </div>
    </section>

    <section class="profile-medals" aria-label="Medallas">
      <header class="section-header">
        <h3>Medallas</h3>
        <span id="profile-medals-count" class="muted-pill">0 desbloqueadas</span>
      </header>
      <div id="profile-medals-list" class="medals-grid"></div>
    </section>

    <section class="profile-analytics" aria-label="Analytics personal">
      <header class="section-header">
        <h3>Analytics personal</h3>
        <span class="muted-pill">Ultimos datos</span>
      </header>
      <div class="profile-kpis profile-analytics-grid">
        <article class="summary-item">
          <p class="stat-label">Cumplimiento 7 dias</p>
          <p id="profile-analytics-week" class="stat-value">0%</p>
        </article>
        <article class="summary-item">
          <p class="stat-label">Cumplimiento 30 dias</p>
          <p id="profile-analytics-month" class="stat-value">0%</p>
        </article>
        <article class="summary-item">
          <p class="stat-label">Franja top</p>
          <p id="profile-analytics-best-hour" class="stat-value">-</p>
        </article>
        <article class="summary-item">
          <p class="stat-label">Tipo dominante</p>
          <p id="profile-analytics-top-type" class="stat-value">-</p>
        </article>
      </div>
    </section>

    <!--
    <section class="profile-heatmap" aria-label="Heatmap de consistencia">
      <header class="section-header">
        <h3>Heatmap de consistencia</h3>
        <span class="muted-pill">12 semanas</span>
      </header>
      <div class="heatmap-legend" aria-hidden="true">
        <span>Poco</span>
        <div class="heatmap-legend-scale">
          <span class="heat-intensity-0"></span>
          <span class="heat-intensity-1"></span>
          <span class="heat-intensity-2"></span>
          <span class="heat-intensity-3"></span>
          <span class="heat-intensity-4"></span>
        </div>
        <span>Mucho</span>
      </div>
      <div id="profile-heatmap-grid" class="heatmap-grid"></div>
    </section>

    <section class="profile-antiprocrastination" aria-label="Sistema anti-procrastinacion">
      <header class="section-header">
        <h3>Sistema anti-procrastinacion</h3>
        <span class="muted-pill">Sugerencias</span>
      </header>
      <div id="profile-focus-suggestions" class="focus-suggestions"></div>
    </section>
    -->

    <div id="profile-battle-pass-modal" class="modal" aria-hidden="true">
      <div class="modal-card battle-pass-modal-card">
        <header class="modal-header">
          <h3>Pase de batalla</h3>
          <button class="icon-btn" type="button" data-action="close-battle-pass-modal" aria-label="Cerrar">X</button>
        </header>
        <div class="battle-pass-modal-summary">
          <article class="summary-item">
            <p class="stat-label">XP total</p>
            <p id="profile-battle-pass-modal-xp" class="stat-value">0 XP</p>
          </article>
          <article class="summary-item">
            <p class="stat-label">Reclamadas</p>
            <p id="profile-battle-pass-modal-count" class="stat-value">0/0</p>
          </article>
        </div>
        <div class="battle-pass-modal-rail">
          <div class="progress-track battle-pass-track" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
            <div id="profile-battle-pass-modal-progress" class="progress-fill battle-pass-progress" style="width:0%"></div>
          </div>
          <div id="profile-battle-pass-modal-list" class="battle-pass-timeline"></div>
        </div>
      </div>
    </div>

    <div id="profile-motes-modal" class="modal" aria-hidden="true">
      <div class="modal-card cosmetics-modal-card">
        <header class="modal-header">
          <h3>Tus motes</h3>
          <button class="icon-btn" type="button" data-action="close-motes-modal" aria-label="Cerrar">X</button>
        </header>
        <p class="modal-copy">Equipa un mote desbloqueado en el pase de batalla.</p>
        <div id="profile-motes-modal-list" class="motes-grid">
          <p class='empty-message'>Reclama un mote en el pase de batalla para poder equiparlo.</p>
        </div>
      </div>
    </div>

    <div id="profile-themes-modal" class="modal" aria-hidden="true">
      <div class="modal-card cosmetics-modal-card theme-picker-modal">
        <header class="modal-header">
          <h3>Elige tema</h3>
          <button class="icon-btn" type="button" data-action="close-themes-modal" aria-label="Cerrar">X</button>
        </header>
        <p class="modal-copy">Selecciona un tema disponible para tu perfil.</p>
        <div class="theme-picker">
          <button class="theme-btn" type="button" data-action="set-theme" data-theme="ocean">
            <span class="theme-dot ocean"></span>
            Ocean
          </button>
          <button class="theme-btn" type="button" data-action="set-theme" data-theme="sunset">
            <span class="theme-dot sunset"></span>
            Sunset
          </button>
          <button class="theme-btn" type="button" data-action="set-theme" data-theme="forest">
            <span class="theme-dot forest"></span>
            Forest
          </button>
          <button class="theme-btn" type="button" data-action="set-theme" data-theme="aurora">
            <span class="theme-dot aurora"></span>
            Aurora
          </button>
          <button class="theme-btn" type="button" data-action="set-theme" data-theme="hell">
            <span class="theme-dot hell"></span>
            Hell
          </button>
          <button class="theme-btn" type="button" data-action="set-theme" data-theme="heaven">
            <span class="theme-dot heaven"></span>
            Heaven
          </button>
        </div>
      </div>
    </div>

    <div id="profile-frame-preview-modal" class="modal" aria-hidden="true">
      <div id="profile-frame-preview-card" class="modal-card confirm-card" data-avatar-skin="classic">
        <header class="modal-header">
          <h3>Vista de marco</h3>
          <button class="icon-btn" type="button" data-action="close-frame-preview-modal" aria-label="Cerrar">X</button>
        </header>
        <p class="modal-copy">Previsualiza como queda tu foto con el marco seleccionado.</p>
        <div class="avatar-wrap">
          <img id="profile-frame-preview-img" alt="Vista previa del avatar" hidden />
          <div id="profile-frame-preview-fallback" class="avatar-fallback" data-avatar-skin="classic">?</div>
        </div>
        <footer class="modal-actions">
          <button class="btn" type="button" data-action="clear-frame-preview">Quitar preview</button>
          <button class="btn btn-primary" type="button" data-action="close-frame-preview-modal">Cerrar</button>
        </footer>
      </div>
    </div>

    <div id="profile-avatar-modal" class="modal" aria-hidden="true">
      <div class="modal-card cosmetics-modal-card">
        <header class="modal-header">
          <h3>Elige marco</h3>
          <button class="icon-btn" type="button" data-action="close-avatar-modal" aria-label="Cerrar">X</button>
        </header>
        <p class="modal-copy">Selecciona un marco decorativo para tu foto de perfil.</p>
        <div class="avatar-picker-grid">
          <button class="avatar-preset-btn" type="button" data-action="select-frame-preset" data-avatar-preset="classic"><span class="avatar-preset-dot onyx">0</span><span>Sin marco</span></button>
          <button class="avatar-preset-btn" type="button" data-action="select-frame-preset" data-avatar-preset="dawn"><span class="avatar-preset-dot dawn">V</span><span>Valla celestial</span></button>
          <button class="avatar-preset-btn" type="button" data-action="select-frame-preset" data-avatar-preset="mint"><span class="avatar-preset-dot mint">F</span><span>Gorro de Finn</span></button>
          <button class="avatar-preset-btn" type="button" data-action="select-frame-preset" data-avatar-preset="ember"><span class="avatar-preset-dot ember">B</span><span>Casco nocturno</span></button>
          <button class="avatar-preset-btn" type="button" data-action="select-frame-preset" data-avatar-preset="violet"><span class="avatar-preset-dot violet">S</span><span>Serafín</span></button>
          <button class="avatar-preset-btn" type="button" data-action="select-frame-preset" data-avatar-preset="sun"><span class="avatar-preset-dot sun">H</span><span>Halo solar</span></button>
          <button class="avatar-preset-btn" type="button" data-action="select-frame-preset" data-avatar-preset="sea"><span class="avatar-preset-dot sea">O</span><span>Ola marina</span></button>
          <button class="avatar-preset-btn" type="button" data-action="select-frame-preset" data-avatar-preset="rose"><span class="avatar-preset-dot rose">C</span><span>Corona rosa</span></button>
          <button class="avatar-preset-btn" type="button" data-action="select-frame-preset" data-avatar-preset="onyx"><span class="avatar-preset-dot onyx">U</span><span>Caballero umbrío</span></button>
        </div>
      </div>
    </div>
  </article>

  <div id="profile-name-modal" class="modal" aria-hidden="true">
    <div class="modal-card confirm-card">
      <header class="modal-header">
        <h3>Cambiar nombre</h3>
        <button id="close-name-modal" class="icon-btn" type="button" aria-label="Close">X</button>
      </header>
      <form id="profile-name-form" class="task-form">
        <label>
          <span>Nombre visible</span>
          <input id="profile-name-input" type="text" maxlength="40" placeholder="Tu nombre" required />
        </label>
        <footer class="modal-actions">
          <button id="cancel-name-modal" class="btn" type="button">Cancelar</button>
          <button class="btn btn-primary" type="submit">Guardar nombre</button>
        </footer>
      </form>
    </div>
  </div>
</section>
