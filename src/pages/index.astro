---
import AppNavigation from "../components/AppNavigation.astro";
import TodayView from "../components/TodayView.astro";
import WeekView from "../components/WeekView.astro";
import MonthView from "../components/MonthView.astro";
import DayDetailView from "../components/DayDetailView.astro";
import GoalsView from "../components/GoalsView.astro";
import ProfileView from "../components/ProfileView.astro";
import TaskModal from "../components/TaskModal.astro";

import "../styles/app.css";

---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/habitly.png" />
		<link rel="shortcut icon" type="image/png" href="/habitly.png" />
		<link rel="apple-touch-icon" href="/habitly.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="theme-color" content="#0f1522" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<title>Habitly - Weekly Study Planner</title>
	</head>
	<body>
		<main class="app-shell">
			<header class="app-top">
				<p class="app-date" id="app-date"></p>
				<h1 class="app-title">Habitly Planner</h1>
				<p class="sync-pill" id="sync-status" data-sync-status="idle">Sin cambios recientes</p>
			</header>

			<AppNavigation />

			<section class="task-search-shell" aria-label="Buscar tareas">
				<label class="task-search-label" for="task-search-input">Buscar tareas por titulo</label>
				<input
					id="task-search-input"
					type="search"
					placeholder="Escribe un titulo..."
					autocomplete="off"
				/>
			</section>

			<section class="views-wrap">
				<TodayView />
				<WeekView />
				<MonthView />
				<DayDetailView />
				<GoalsView />
				<ProfileView />
			</section>
		</main>

		<div id="profile-settings-modal" class="modal" aria-hidden="true">
			<div class="modal-card settings-modal-card">
				<header class="modal-header">
					<h3>Ajustes</h3>
					<button class="icon-btn" type="button" data-action="close-settings-modal" aria-label="Cerrar">X</button>
				</header>
				<p class="modal-copy">Tipografía, tema, mote y lo que venga después.</p>

				<div class="settings-modal-grid">
					<article class="setting-card">
						<div class="setting-card-head">
							<p class="equipment-label">Tipografía</p>
							<span class="setting-preview">Global</span>
						</div>
						<label class="setting-field" for="profile-font-select">
							<span>Fuente de la app</span>
							<select id="profile-font-select" name="profile-font-select">
								<option value="sora">Sora</option>
								<option value="manrope">Manrope</option>
								<option value="plus-jakarta-sans">Plus Jakarta Sans</option>
								<option value="inter">Inter</option>
							</select>
						</label>
						<p class="setting-note">Se aplica a toda la web y se guarda en tu perfil.</p>
					</article>

					<article class="setting-card">
						<div class="setting-card-head">
							<p class="equipment-label">Tema</p>
							<span class="setting-preview">Visual</span>
						</div>
						<p class="setting-note">Abre el selector de temas para cambiar colores y contraste.</p>
						<button class="btn btn-primary" type="button" data-action="open-themes-modal">Cambiar tema</button>
					</article>

					<article class="setting-card">
						<div class="setting-card-head">
							<p class="equipment-label">Mote</p>
							<span class="setting-preview">Identidad</span>
						</div>
						<p class="setting-note">Abre tu colección de motes desbloqueados.</p>
						<button class="btn btn-primary" type="button" data-action="open-motes-modal">Cambiar mote</button>
					</article>

					<article class="setting-card setting-card-muted">
						<div class="setting-card-head">
							<p class="equipment-label">Idioma</p>
							<span class="setting-preview">Próximamente</span>
						</div>
						<p class="setting-note">Lo dejamos preparado para más adelante.</p>
						<button class="btn" type="button" disabled>Disponible más adelante</button>
					</article>
				</div>
			</div>
		</div>

		<TaskModal />

		<script>
			import "../scripts/app.js";
		</script>
	</body>
</html>
